#!/usr/bin/env python3

import os
import re
import sys
import shutil
import subprocess
from pathlib import Path
from datetime import datetime

CONFIG = Path("/boot/firmware/config.txt")
RULE = Path("/etc/udev/rules.d/99-ads7846-calibration.rules")
MIRROR = Path("/usr/local/bin/spi-mirror.sh")

CALIBRATION = {
    270: "0.000462 1.092691 -0.053591 -1.112591 0.000905 1.062629",
    90: "-0.000462 -1.092691 1.053591 1.112591 -0.000905 -0.062629",
    0: "1.112591 -0.000905 -0.062629 0.000462 1.092691 -0.053591",
    180: "-1.112591 0.000905 1.062629 -0.000462 -1.092691 1.053591",
}

def main():
    if os.geteuid() != 0:
        sys.exit("Run with sudo.")

    if len(sys.argv) != 2 or sys.argv[1] not in ("0", "90", "180", "270"):
        sys.exit("Usage: sudo spi-rotate [0|90|180|270]")

    angle = int(sys.argv[1])
    width, height = (320, 480) if angle in (0, 180) else (480, 320)

    for path in (CONFIG, RULE, MIRROR):
        if not path.is_file():
            sys.exit(f"File not found: {path}")

    config = CONFIG.read_text()
    rule = RULE.read_text()
    mirror = MIRROR.read_text()

    config_pattern = r"(?m)^(\s*dtoverlay=mhs35:rotate=)(0|90|180|270)(,speed=\d+\s*)$"
    rule_pattern = r'ENV\{LIBINPUT_CALIBRATION_MATRIX\}="[^"]+"'
    scale_pattern = r"scale=\d+:\d+:flags=fast_bilinear"

    if len(re.findall(config_pattern, config)) != 1:
        sys.exit("Error: Expected exactly one MHS35 rotation setting.")

    if len(re.findall(rule_pattern, rule)) != 1:
        sys.exit("Error: Expected exactly one calibration matrix.")

    if len(re.findall(scale_pattern, mirror)) != 1:
        sys.exit("Error: Expected exactly one ffmpeg scale setting.")

    new_config = re.sub(
        config_pattern,
        lambda m: m.group(1) + str(angle) + m.group(3),
        config
    )

    new_rule = re.sub(
        rule_pattern,
        f'ENV{{LIBINPUT_CALIBRATION_MATRIX}}="{CALIBRATION[angle]}"',
        rule
    )

    new_mirror = re.sub(
        scale_pattern,
        f"scale={width}:{height}:flags=fast_bilinear",
        mirror
    )

    if (new_config, new_rule, new_mirror) == (config, rule, mirror):
        print(f"Already configured for {angle} degrees.")
        return

    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")

    for path in (CONFIG, RULE, MIRROR):
        shutil.copy2(path, str(path) + f".bak-{stamp}")

    CONFIG.write_text(new_config)
    RULE.write_text(new_rule)
    MIRROR.write_text(new_mirror)

    print(f"Rotation set to {angle} degrees.")
    print(f"Resolution: {width}x{height}")
    print("Display and touchscreen settings updated.")

    answer = input("Reboot now? [Y/n]: ").strip().lower()

    if answer in ("", "y"):
        subprocess.run(["systemctl", "reboot"], check=True)
    else:
        print("Reboot later to apply the settings.")

if __name__ == "__main__":
    main()
